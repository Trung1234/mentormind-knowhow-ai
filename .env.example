# Copy to .env and edit (spec 01 §4). .env is THE config file: KNOWHOW_* settings, the vendor
# API keys and the Compose variables all live here. It is gitignored; never commit it.
# How to obtain each vendor's key: .secrets/README.md (that folder is documentation only).
KNOWHOW_NEO4J_URI=bolt://localhost:7687
KNOWHOW_NEO4J_USER=neo4j
KNOWHOW_NEO4J_PASSWORD=change-me
KNOWHOW_VECTOR_BACKEND=pgvector        # pgvector | memory
KNOWHOW_PG_DSN=postgresql://knowhow:change-me@localhost:5432/knowhow
KNOWHOW_VECTOR_TABLE=knowhow_chunks
KNOWHOW_EMBED_DIM=1024                 # bge-m3 dense
KNOWHOW_EMBED_MODEL=BAAI/bge-m3
KNOWHOW_EMBEDDER=bge-m3               # bge-m3 | hashing (hashing = stand-in with no semantics, dev only)
# spec 02 ingest: Docling is the extractor; mmore is the degraded PDF fallback (install it separately)
KNOWHOW_MMORE_BIN=mmore
KNOWHOW_TOKEN_COUNTER=bge-m3          # bge-m3 | whitespace (offline; undercounts Japanese/Vietnamese)

# VLM (spec 04). `uv run knowhow vlm providers` lists every provider and whether its key is set.
KNOWHOW_VLM_PROVIDER=local_openai      # local_openai | openrouter | siliconflow | qwen_api | openai_compatible | fake
# Empty = the provider's default endpoint (local_openai: http://127.0.0.1:8100/v1) and its own
# id for Qwen3-VL-8B-Instruct. (Keep comments off empty values: dotenv would read them as the value.)
KNOWHOW_VLM_BASE_URL=
KNOWHOW_VLM_MODEL=
KNOWHOW_VLM_FPS=4
KNOWHOW_VLM_MAX_FRAMES=48
KNOWHOW_VLM_TIMEOUT_S=90
KNOWHOW_VLM_MAX_RETRIES=3
KNOWHOW_VLM_JSON_MODE=auto             # auto | json_schema | json_object | off
KNOWHOW_VLM_MAX_TOKENS=2048
KNOWHOW_VLM_EXTRA_BODY={"presence_penalty": 1.5}   # stops Qwen3-VL looping long step lists

# LLM (spec 06; also spec 04 pass C). Same provider names as the VLM; same keys below.
KNOWHOW_LLM_PROVIDER=qwen_api          # qwen_api | local_openai | openrouter | siliconflow | openai_compatible | fake
# Empty = the provider's default model (qwen_api: qwen-plus; local_openai: the self-hosted Qwen3-VL).
KNOWHOW_LLM_BASE_URL=
KNOWHOW_LLM_MODEL=
KNOWHOW_LLM_MAX_TOKENS=1024

# REST API (spec 08): `uvicorn mentormind.backend.app.main:app`. CORS = the UI's origin only.
KNOWHOW_APP_NAME=MentorMind Know-How API
KNOWHOW_CORS_ORIGINS=["http://localhost:5173"]

KNOWHOW_PROFILE_DB=data/work/profiles.sqlite
# auto = profile store of spec 08 when present, else data/work/vlm/<video_id>/profiles.json
KNOWHOW_PROFILE_SINK=auto
KNOWHOW_SIGMA_ADAPTER=csv
KNOWHOW_SIGMA_CSV_DIR=data/mock_sigma


# --- API keys (spec 01 FR-09). Cloud keys are only for public/synthetic data: DataGuard blocks
# factory_confidential from ever reaching a cloud provider. How to get each key: .secrets/README.md
OPENROUTER_API_KEY=
SILICONFLOW_API_KEY=
DASHSCOPE_API_KEY=
# Alibaba Singapore: the workspace host shown next to the key, as a full base URL
#   https://<WorkspaceId>.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_BASE_URL=
# Optional bearer token protecting the self-hosted server (server and client read the same name).
VLM_SERVER_API_KEY=
# Optional: faster, less rate-limited Hugging Face downloads of the Qwen3-VL checkpoint.
HF_TOKEN=
# Optional: force one key for whichever provider is selected (beats the vendor names above).
# KNOWHOW_VLM_API_KEY=
# KNOWHOW_LLM_API_KEY=

# --- Video capture (spec 03). ffmpeg/ffprobe must be installed (macOS: brew install ffmpeg) ---
# KNOWHOW_SCENE_THRESHOLD=20            # PySceneDetect ContentDetector; 20 beat 27 on recall (spike T03-0)
# KNOWHOW_SEGMENT_WINDOW_S=10           # fixed_window fallback
# KNOWHOW_MOTION_SCALE=0.1              # median frame difference that maps to motion_score 1.0
# KNOWHOW_WHISPER_MODEL=small           # local faster-whisper only; first use downloads the model
# KNOWHOW_WHISPER_LANGUAGE=vi           # or auto to let Whisper detect (the LASI demo is Thai)
# hand_activity runs MediaPipe in its own process: by default `uv run --with mediapipe==0.10.21`.
# KNOWHOW_HAND_PYTHON=                  # or a Python that already has mediapipe 0.10.x
# KNOWHOW_HAND_MIN_PRESENCE=0.1         # refuse (fall back to scene) when fewer frames show a hand

# --- Docker Compose (docker-compose.yml + infra/docker/*.yml; spec 01 FR-05, task D3) ---
# Start Qwen3-VL-8B together with the vlm-server container (false = start it on demand).
VLM_SERVER_AUTOSTART=false
# The ONE GPU (or MI250 GCD) given to vlm-server.
VLM_GPU=0
VLM_SERVER_PORT=8100
# Rootful Docker: files the container creates in the bind-mounted repo stay yours.
DEV_UID=1000
DEV_GID=1000
# Where the 17 GB Qwen3-VL checkpoint is cached (bind-mounted into vlm-server).
HF_CACHE=~/.cache/huggingface
# AMD only (infra/docker/docker-compose.rocm.yml). HOST GIDs of /dev/kfd and /dev/dri/renderD*:
#   getent group video render
DRI_VIDEO_GID=44
DRI_RENDER_GID=109
# AMD only: base image of Dockerfile.rocm; must list gfx90a for an MI250.
#   docker run --rm $ROCM_VLLM_IMAGE python3 -c "import torch; print(torch.cuda.get_arch_list())"
ROCM_VLLM_IMAGE=rocm/vllm:rocm7.14.1_cdna_ubuntu24.04_py3.14_pytorch_2.11_vllm_0.23.0
KNOWHOW_PG_PASSWORD=change-me
KNOWHOW_PG_PORT=5432
KNOWHOW_NEO4J_HTTP_PORT=7474
KNOWHOW_NEO4J_BOLT_PORT=7687
