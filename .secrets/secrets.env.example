# Mẫu file secret. Cách dùng (xem .secrets/README.md):
#   cp .secrets/secrets.env.example .secrets/secrets.env && chmod 600 .secrets/secrets.env
# .secrets/secrets.env bị .gitignore chặn — KHÔNG BAO GIỜ commit, không dán key vào chat/Slack.

# --- Cloud VLM providers (chỉ dùng với dữ liệu public/synthetic — DataGuard tự chặn dữ liệu nhà máy)
OPENROUTER_API_KEY=
SILICONFLOW_API_KEY=
DASHSCOPE_API_KEY=
# Singapore workspace host shown next to the key: https://<WorkspaceId>.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_BASE_URL=

# --- Token bảo vệ server tự host 3rdparty/vlm_server (tùy chọn; server và client cùng đọc biến này)
VLM_SERVER_API_KEY=

# --- Tùy chọn: tải model từ Hugging Face nhanh hơn / ít bị giới hạn hơn
HF_TOKEN=

# --- Tùy chọn: ép dùng một key cho provider đang chọn, bất kể tên vendor (ưu tiên cao nhất)
# KNOWHOW_VLM_API_KEY=
