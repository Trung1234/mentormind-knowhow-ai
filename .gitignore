# Dependencies
node_modules/

# Environment
.env
.env.*
!.env.example

# Secrets — API keys live here, never in git. Only the setup guide and the template are tracked.
.secrets/*
!.secrets/README.md
!.secrets/secrets.env.example

# Personal guides generated for one developer (not shared).
guidance/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Frontend build
mentormind/frontend/dist/

# Data — never commit (constitution Điều 2 / spec 01 FR-06)
data/raw/
data/factory/
data/work/

# Real video/audio never enters git; small public/synthetic samples under data/samples/ may.
*.mp4
*.mov
*.mkv
*.webm
*.avi
*.wav
*.mp3
!data/samples/**/*.mp4
!data/samples/**/*.mov
!data/samples/**/*.mkv
!data/samples/**/*.webm
!data/samples/**/*.wav
!data/samples/**/*.mp3

# OS / IDE
.DS_Store
.vscode/
.idea/
